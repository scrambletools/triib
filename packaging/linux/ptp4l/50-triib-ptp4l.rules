// Lets the person at the computer start and stop triib's two ptp4l
// units, as triib-endpointd does when its talkers and listeners fall
// back to AVB Lite and when the link comes up again.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" ||
        !subject.local || !subject.active) {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit") || "";
    var verb = action.lookup("verb");
    if (/^triib-ptp4l-(gptp|lite)@[A-Za-z0-9_.-]+\.service$/.test(unit) &&
        (verb === "start" || verb === "stop" || verb === "restart")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
