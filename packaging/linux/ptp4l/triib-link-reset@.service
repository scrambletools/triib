[Unit]
Description=Restart %i for triib, as its driver keeps PTP time stamps
Documentation=man:ip-link(8)
After=sys-subsystem-net-devices-%i.device

# Some drivers (atlantic) leave their hardware time stamps on received
# PTP frames after the link renegotiates, from a cable unplugged as well
# as a PAUSE change, until the interface goes down and up again; ptp4l
# then drops every frame. triib-endpointd runs this when it sees them.
# An interface that is down stays down.
[Service]
Type=oneshot
ExecStart=/bin/sh -c '\
    [ $$(( $$(cat "/sys/class/net/$$1/flags") & 1 )) -eq 1 ] || exit 0; \
    ip link set "$$1" down && ip link set "$$1" up' sh %i
